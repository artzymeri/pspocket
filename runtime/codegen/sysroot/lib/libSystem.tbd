--- !tapi-tbd
# The libSystem symbols code compiled on the phone may call (route B, D-151), by name: the linker needs to know they
# exist; the phone's libSystem has them. Written for pspocket, not taken from an SDK.
tbd-version: 4
targets: [ arm64-ios, arm64-macos ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 1351
exports:
  - targets: [ arm64-ios, arm64-macos ]
    symbols: [ _memcpy, _memmove, _memset, _memcmp, _strlen, _sqrt, _sqrtf, _fma, _fmaf, _fabs, _fabsf, _floor,
               _ceil, _trunc, _round, _rint, _nearbyint, _exp2f, _log2f, _copysign, ___stack_chk_fail,
               ___stack_chk_guard, ___chkstk_darwin, _bzero ]
...
