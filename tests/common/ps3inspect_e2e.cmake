# ps3inspect end-to-end test (run by CTest with cmake -P).
#   -DGENERATOR=<make_synthetic_ps3_binaries> -DPS3INSPECT=<ps3inspect> -DWORK_DIR=<scratch dir>
# Writes synthetic binaries, runs ps3inspect on them and checks exit codes and key JSON fields.

cmake_minimum_required(VERSION 3.24)

foreach(var GENERATOR PS3INSPECT WORK_DIR)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "ps3inspect_e2e.cmake: -D${var}=... is required")
    endif()
endforeach()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

execute_process(COMMAND "${GENERATOR}" "${WORK_DIR}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "generator failed (${rc})")
endif()

set(failures 0)

# run(<expected exit code> <stdout var> <stderr var> args...)
function(run expected out_var err_var)
    execute_process(COMMAND "${PS3INSPECT}" ${ARGN}
        WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL expected)
        message(SEND_ERROR "ps3inspect ${ARGN}: exit ${rc}, expected ${expected}\nstdout:\n${out}\nstderr:\n${err}")
    endif()
    set(${out_var} "${out}" PARENT_SCOPE)
    set(${err_var} "${err}" PARENT_SCOPE)
endfunction()

# expect_json(<json> <expected value> <path...>)
function(expect_json json expected)
    string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error)
        message(SEND_ERROR "JSON path '${ARGN}': ${error}")
    elseif(NOT "${value}" STREQUAL "${expected}")
        message(SEND_ERROR "JSON path '${ARGN}': got '${value}', expected '${expected}'")
    endif()
endfunction()

function(expect_json_length json expected)
    string(JSON value ERROR_VARIABLE error LENGTH "${json}" ${ARGN})
    if(error)
        message(SEND_ERROR "JSON path '${ARGN}': ${error}")
    elseif(NOT value EQUAL expected)
        message(SEND_ERROR "JSON length of '${ARGN}': got ${value}, expected ${expected}")
    endif()
endfunction()

# 1. Decrypted-style PPU executable, with extra names for its own exports.
run(0 out err --json exec.json --names extra_names.txt synthetic_exec.elf)
file(READ "${WORK_DIR}/exec.json" json)
expect_json("${json}" "ps3inspect" tool)
expect_json("${json}" "0" exit_status)
expect_json_length("${json}" 1 files)
expect_json("${json}" "ppu_executable" files 0 type)
expect_json("${json}" "OFF" files 0 encrypted)
expect_json("${json}" "0x00360001" files 0 process_param sdk_version)
expect_json("${json}" "1001" files 0 process_param primary_prio)
expect_json("${json}" "ON" files 0 prx_param magic_ok)
expect_json_length("${json}" 8 files 0 imports)
expect_json("${json}" "cellGcmSys" files 0 imports 0 module)
expect_json("${json}" "0x4ae8d215" files 0 imports 0 functions 1 nid)
expect_json("${json}" "cellGcmSetFlipMode" files 0 imports 0 functions 1 name)
expect_json("${json}" "exact" files 0 imports 0 functions 1 match)
expect_json("${json}" "synthetic_export_func" files 0 exports 1 functions 0 name)
expect_json("${json}" "section" files 0 opd source)
expect_json("${json}" "8" files 0 opd count)
expect_json("${json}" "2" files 0 spu_images count)
expect_json("${json}" "synthetic_job" files 0 spu_images images 0 name)
expect_json("${json}" "custom" files 0 spu_images images 0 class)
expect_json("${json}" "sony_middleware" files 0 spu_images images 1 class)
expect_json("${json}" "7" files 0 phase0 function_estimate)
expect_json("${json}" "14" files 0 phase0 imported_functions)
expect_json("${json}" "1" files 0 phase0 imported_variables)
expect_json_length("${json}" 8 files 0 phase0 imports)
expect_json_length("${json}" 1 files 0 phase0 unresolved)
expect_json("${json}" "0xdeadbeef" files 0 phase0 unresolved 0 nid)
expect_json("${json}" "1" files 0 phase0 spu sony_middleware)
expect_json("${json}" "1" files 0 phase0 spu custom)
if(NOT out MATCHES "Phase 0 summary")
    message(SEND_ERROR "text report has no Phase 0 summary block")
endif()
if(NOT out MATCHES "loaded 2 names from extra_names.txt")
    message(SEND_ERROR "--names was not reported")
endif()

# 2. An encrypted SELF: recognized, reported as encrypted, exit status 3.
run(3 out err --quiet --json self.json synthetic_retail.self)
file(READ "${WORK_DIR}/self.json" json)
expect_json("${json}" "self" files 0 type)
expect_json("${json}" "ON" files 0 encrypted)
expect_json("${json}" "8" files 0 self app_info self_type)
expect_json("${json}" "3" files 0 self control_info 2 npdrm license)
expect_json_length("${json}" 5 files 0 self segments)
if(NOT out STREQUAL "")
    message(SEND_ERROR "--quiet printed a report:\n${out}")
endif()
run(3 out err synthetic_retail.self)
if(NOT out MATCHES "Decrypt PS3")
    message(SEND_ERROR "the SELF report does not point at RPCS3's decryption utility")
endif()

# 3. A PRX.
run(0 out err --quiet --json prx.json synthetic_prx.prx)
file(READ "${WORK_DIR}/prx.json" json)
expect_json("${json}" "ppu_prx" files 0 type)
expect_json("${json}" "synthetic_prx" files 0 module_info name)
expect_json("${json}" "sys_lwmutex_lock" files 0 imports 0 functions 0 name)
expect_json("${json}" "module_start" files 0 exports 0 functions 0 name)

# 4. SPU extraction warns that the output is game-derived and writes one file per image.
run(0 out err --quiet --spu-extract spu_out synthetic_exec.elf)
if(NOT err MATCHES "out of git")
    message(SEND_ERROR "--spu-extract did not warn about keeping its output out of git:\n${err}")
endif()
file(GLOB extracted "${WORK_DIR}/spu_out/*.elf")
list(LENGTH extracted count)
if(NOT count EQUAL 2)
    message(SEND_ERROR "--spu-extract wrote ${count} files, expected 2")
endif()

# 5. Strings, a standalone SPU ELF, unknown input, several files, usage errors.
run(0 out err --strings --min-string 12 synthetic_exec.elf)
if(NOT out MATCHES "rage::grcDevice::BeginFrame")
    message(SEND_ERROR "--strings did not list the RAGE string")
endif()
run(0 out err --quiet --json spu.json synthetic_spu.elf)
file(READ "${WORK_DIR}/spu.json" json)
expect_json("${json}" "spu_elf" files 0 type)
expect_json("${json}" "standalone_job" files 0 spu_images images 0 name)
run(2 out err --quiet junk.bin)
run(3 out err --quiet --json multi.json synthetic_exec.elf synthetic_retail.self)
file(READ "${WORK_DIR}/multi.json" json)
expect_json_length("${json}" 2 files)
expect_json("${json}" "3" exit_status)
run(2 out err --quiet synthetic_exec.elf synthetic_retail.self junk.bin)
run(1 out err --quiet missing_file.elf)
run(1 out err --bogus-option synthetic_exec.elf)
run(1 out err --min-string 0 synthetic_exec.elf)
run(1 out err)
run(0 out err --help)
