# Writes OUT: the C definitions of ps_game_abi_hash and ps_game_translator_hash (route B, D-152), the first 64 bits of
# a SHA-256 over the SHA-256s of ABI_FILES and of TRANSLATOR_FILES, in the order given. Run by runtime/game's build
# whenever one of those files changes; OUT is rewritten only when a hash changes.
function(pspocket_hash_files out_var files)
    set(acc "")
    foreach(f IN LISTS files)
        file(SHA256 "${f}" h)
        string(APPEND acc "${h}")
    endforeach()
    string(SHA256 all "${acc}")
    string(SUBSTRING "${all}" 0 16 short)
    set(${out_var} "${short}" PARENT_SCOPE)
endfunction()

pspocket_hash_files(abi "${ABI_FILES}")
pspocket_hash_files(translator "${TRANSLATOR_FILES}")
file(WRITE "${OUT}.tmp" "/* Generated by cmake/GameAbiHash.cmake (runtime/game): do not edit. */\n"
    "#include <stdint.h>\n"
    "/* The ABI headers translated code is compiled against (pspocket/game/library.h). */\n"
    "extern const uint64_t ps_game_abi_hash;\n"
    "const uint64_t ps_game_abi_hash = 0x${abi}ull;\n"
    "/* The lifters' sources: a library translated by other ones would translate differently. */\n"
    "extern const uint64_t ps_game_translator_hash;\n"
    "const uint64_t ps_game_translator_hash = 0x${translator}ull;\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
